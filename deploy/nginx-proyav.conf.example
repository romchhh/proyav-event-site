# Example nginx site config for proyav uploads.
# Put `client_max_body_size` in the `server` or `location` that proxies to Next.js.
#
# After edit:
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name proyav.ua www.proyav.ua;

    # Must be >= Next bodySizeLimit (25mb) and app upload limit (20 MB)
    client_max_body_size 25m;

    # Optional: avoid timeouts on slow mobile uploads
    client_body_timeout 60s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
    }

    # Explicit upload endpoint (same limit)
    location /api/admin/upload {
        client_max_body_size 25m;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 120s;
    }
}
